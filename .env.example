# Copier ce fichier en .env.local puis renseigner les valeurs (Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://<ref-du-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optionnel: URL publique du site (canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://exemple.fr
