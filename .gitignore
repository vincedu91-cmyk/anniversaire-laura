# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files: modèle versionné, vrais secrets jamais
!.env.example

# données personnelles: les photos restent en local (voir DESIGN.md)
/photos/*
!/photos/*/
/photos/*/*
!/photos/*/.gitkeep
/public/photos/
/public/film/*
!/public/film/.gitkeep

# production du film (workspace séparé du site)
/assets/
/video/

# divers locaux
*.stackdump
/.claude/
